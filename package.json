		"keybindings": [
			{
				"command": "hoi4modernutils.openkeybindings",
				"key": "ctrl+alt+k"
			},
			{
				"command": "hoi4modernutils.worldMap.paintBrush",
				"key": "p",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.paintEraser",
				"key": "e",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned && hoi4ModernUtils.worldMapTool == 'paint'"
			},
			{
				"command": "hoi4modernutils.worldMap.fillBucket",
				"key": "f",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.lasso",
				"key": "l",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.transferWand",
				"key": "w",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.createNewProvince",
				"key": "ctrl+alt+p",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.cancel",
				"key": "escape",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.mapUndo",
				"key": "ctrl+z",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.mapRedo",
				"key": "ctrl+y",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.selectionUndo",
				"key": "t",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.selectionRedo",
				"key": "r",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.createStateFromSelection",
				"key": "ctrl+shift+n",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.assignSelectionToState",
				"key": "ctrl+enter",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.assignSelectionToStrategicRegion",
				"key": "ctrl+shift+g",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.toggleRailwayEditor",
				"key": "ctrl+alt+r",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.toggleSupplyHubMode",
				"key": "ctrl+alt+h",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.toggleBuildingEditor",
				"key": "ctrl+alt+b",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.openInterfaceMenu",
				"key": "ctrl+alt+i",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.openAccessibilityMenu",
				"key": "ctrl+alt+a",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
				"command": "hoi4modernutils.worldMap.openPerformanceMenu",
				"key": "ctrl+alt+shift+p",
				"when": "hoi4ModernUtils.worldMapFocused && !hoi4ModernUtils.worldMapKeyboardOwned"
			},
			{
