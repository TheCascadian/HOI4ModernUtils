		"compile-ts": "tsc -d -p ./ --module commonjs",
		"lint": "eslint src --ext ts",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile-ts && npm run lint",
		"test": "mocha ./out/test/**/*.test.js",
		"profile-worldmap-render": "webpack --config scripts/profile-worldmap-render.webpack.js && node scripts/.profile-build/profile-worldmap-render.cjs --output profiles/worldmap-render-profile.json",
