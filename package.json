		"profile-worldmap-webview-aggressive": "node scripts/profile-worldmap-webview.js --focused --optimizations warning-index,edge-decimation,river-device-pixel-collapse,label-grid-dedupe,coarse-provinces --allow-pixel-changes --output profiles/worldmap-webview-runtime-aggressive.json",
