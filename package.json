{
	"name": "hoi4modernutils",
	"displayName": "%hoi4modernutils.displayName%",
	"description": "Utilities for Heart of Iron IV mods developers",
	"version": "0.4.4",
	"author": "TheCascadian",
	"publisher": "thecascadian",
	"icon": "icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/TheCascadian/HOI4ModernUtils"
	},
	"engines": {
		"vscode": "^1.52.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"mod",
		"paradox",
		"hoi",
		"Heart of Iron"
	],
	"activationEvents": [
		"onCommand:hoi4modernutils.preview",
		"onCommand:hoi4modernutils.previewworld",
		"onCommand:hoi4modernutils.scanAndLogErrors",
		"onCommand:hoi4modernutils.scanreferences",
		"onCommand:hoi4modernutils.selectmodfile",
		"onCommand:hoi4modernutils.selecthoifolder",
		"onCustomEditor:hoi4modernutils.dds",
		"onCustomEditor:hoi4modernutils.tga",
		"onWebviewPanel:hoi4modernutils.ftpreview",
		"onWebviewPanel:hoi4modernutils.worldmappreview",
		"workspaceContains:**/*.gfx",
		"workspaceContains:common/national_focus/*.txt",
		"workspaceContains:common/technologies/*.txt",
		"workspaceContains:common/military_industrial_organization/organizations/*.txt",
		"workspaceContains:events/*.txt",
		"workspaceContains:interface/*.gui",
		"workspaceContains:map/default.map"
	],
	"main": "./dist/extension.js",
	"browser": "./dist/web-extension.js",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"locale": "%hoi4modernutils.locale%",
	"contributes": {
		"configuration": [
			{
				"title": "%hoi4modernutils.displayName%",
				"properties": {
					"hoi4ModernUtils.installPath": {
						"title": "%hoi4modernutils.installPath.title%",
						"type": "string",
						"default": "",
						"description": "%hoi4modernutils.installPath.desc%"
					},
					"hoi4ModernUtils.loadDlcContents": {
						"title": "%hoi4modernutils.loadDlcContents.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modernutils.loadDlcContents.desc%"
					},
					"hoi4ModernUtils.indexing": {
						"title": "%hoi4modernutils.indexing.title%",
						"type": "array",
						"default": [
							"gfx",
							"sharedfocus",
							"localisation",
							"event"
						],
						"uniqueItems": true,
						"items": {
							"type": "string",
							"enum": [
								"gfx",
								"sharedfocus",
								"localisation",
								"event"
							],
							"enumDescriptions": [
								"%hoi4modernutils.indexing.gfx%",
								"%hoi4modernutils.indexing.sharedfocus%",
								"%hoi4modernutils.indexing.localisation%",
								"%hoi4modernutils.indexing.event%"
							]
						},
						"description": "%hoi4modernutils.indexing.desc%"
					},
					"hoi4ModernUtils.modFile": {
						"title": "%hoi4modernutils.modFile.title%",
						"type": "string",
						"default": "",
						"description": "%hoi4modernutils.modFile.desc%"
					},
					"hoi4ModernUtils.enableSupplyArea": {
						"title": "%hoi4modernutils.enableSupplyArea.title%",
						"type": "boolean",
						"default": false,
						"description": "%hoi4modernutils.enableSupplyArea.desc%"
					},
					"hoi4ModernUtils.previewLocalisation": {
						"title": "%hoi4modernutils.previewLocalisation.title%",
						"type": "string",
						"default": "Use Visual Studio Code Language",
						"enum": [
							"Use Visual Studio Code Language",
							"Brazilian Portuguese",
							"English",
							"French",
							"German",
							"Japanese",
							"Korean",
							"Polish",
							"Russian",
							"Simplified Chinese",
							"Spanish"
						],
						"description": "%hoi4modernutils.previewLocalisation.desc%"
					},
					"hoi4ModernUtils.stateBoundaryColor": {
						"title": "%hoi4modernutils.stateBoundaryColor.title%",
						"type": "string",
						"default": "rgba(0, 0, 0, 0.4)",
						"description": "%hoi4modernutils.stateBoundaryColor.desc%"
					},
					"hoi4ModernUtils.stateBoundaryWidth": {
						"title": "%hoi4modernutils.stateBoundaryWidth.title%",
						"type": "number",
						"default": 1.5,
						"description": "%hoi4modernutils.stateBoundaryWidth.desc%"
					},
					"hoi4ModernUtils.featureFlags": {
						"title": "%hoi4modernutils.featureFlags.title%",
						"type": "array",
						"default": [],
						"uniqueItems": true,
						"items": {
							"type": "string",
							"enum": [
								"useConditionInFocus",
								"eventTreePreview",
								"rightButtonDrag",
								"!useConditionInFocus",
								"!eventTreePreview",
								"!rightButtonDrag"
							]
						},
						"description": "%hoi4modernutils.featureFlags.desc%"
					},
					"hoi4ModernUtils.worldMapSelectionUndoKeybind": {
						"title": "%hoi4modernutils.worldMapSelectionUndoKeybind.title%",
						"type": "string",
						"default": "T",
						"description": "%hoi4modernutils.worldMapSelectionUndoKeybind.desc%"
					},
					"hoi4ModernUtils.worldMapSelectionRedoKeybind": {
						"title": "%hoi4modernutils.worldMapSelectionRedoKeybind.title%",
						"type": "string",
						"default": "R",
						"description": "%hoi4modernutils.worldMapSelectionRedoKeybind.desc%"
					},
					"hoi4ModernUtils.worldMapMapUndoKeybind": {
						"title": "%hoi4modernutils.worldMapMapUndoKeybind.title%",
						"type": "string",
						"default": "Ctrl+Z",
						"description": "%hoi4modernutils.worldMapMapUndoKeybind.desc%"
					},
					"hoi4ModernUtils.worldMapMapRedoKeybind": {
						"title": "%hoi4modernutils.worldMapMapRedoKeybind.title%",
						"type": "string",
						"default": "Ctrl+Y",
						"description": "%hoi4modernutils.worldMapMapRedoKeybind.desc%"
					},
					"hoi4ModernUtils.worldMapCreateStateKeybind": {
						"title": "%hoi4modernutils.worldMapCreateStateKeybind.title%",
						"type": "string",
						"default": "Ctrl+Shift+N",
						"description": "%hoi4modernutils.worldMapCreateStateKeybind.desc%"
					},
					"hoi4ModernUtils.worldMapAssignSelectionKeybind": {
						"title": "%hoi4modernutils.worldMapAssignSelectionKeybind.title%",
						"type": "string",
						"default": "Ctrl+Enter",
						"description": "%hoi4modernutils.worldMapAssignSelectionKeybind.desc%"
					},
					"hoi4ModernUtils.worldMapAssignSelectionToStrategicRegionKeybind": {
						"title": "%hoi4modernutils.worldMapAssignSelectionToStrategicRegionKeybind.title%",
						"type": "string",
						"default": "Ctrl+Shift+G",
						"description": "%hoi4modernutils.worldMapAssignSelectionToStrategicRegionKeybind.desc%"
					},
					"hoi4ModernUtils.worldMapConfirmNewProvinceCreation": {
						"title": "%hoi4modernutils.worldMapConfirmNewProvinceCreation.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modernutils.worldMapConfirmNewProvinceCreation.desc%"
					},
					"hoi4ModernUtils.worldMapAutoCoreTransfers": {
						"title": "%hoi4modernutils.worldMapAutoCoreTransfers.title%",
						"type": "boolean",
						"default": false,
						"description": "%hoi4modernutils.worldMapAutoCoreTransfers.desc%"
					}
				}
			}
		],
		"commands": [
			{
				"command": "hoi4modernutils.preview",
				"title": "%hoi4modernutils.preview.title%",
				"icon": {
					"dark": "static/preview-right-dark.svg",
					"light": "static/preview-right-light.svg"
				},
				"category": "%hoi4modernutils.category%"
			},
			{
				"command": "hoi4modernutils.selectmodfile",
				"title": "%hoi4modernutils.selectmodfile.title%",
				"category": "%hoi4modernutils.category%"
			},
			{
				"command": "hoi4modernutils.previewworld",
				"title": "%hoi4modernutils.previewworld.title%",
				"category": "%hoi4modernutils.category%"
			},
			{
				"command": "hoi4modernutils.scanreferences",
				"title": "%hoi4modernutils.scanreferences.title%",
				"icon": "$(references)",
				"category": "%hoi4modernutils.category%"
			},
			{
				"command": "hoi4modernutils.scanAndLogErrors",
				"title": "%hoi4modernutils.scanAndLogErrors.title%",
				"icon": "$(warning)",
				"category": "%hoi4modernutils.category%"
			},
			{
				"command": "hoi4modernutils.selecthoifolder",
				"title": "%hoi4modernutils.selecthoifolder.title%",
				"category": "%hoi4modernutils.category%"
			},
			{
				"command": "hoi4modernutils.test",
				"title": "HOI4 test",
				"category": "%hoi4modernutils.category%"
			}
		],
		"customEditors": [
			{
				"viewType": "hoi4modernutils.dds",
				"displayName": "%hoi4modernutils.dds.editorName%",
				"selector": [
					{
						"filenamePattern": "*.dds"
					}
				]
			},
			{
				"viewType": "hoi4modernutils.tga",
				"displayName": "%hoi4modernutils.tga.editorName%",
				"selector": [
					{
						"filenamePattern": "*.tga"
					}
				]
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "hoi4modernutils.preview",
					"when": "!shouldShowHoi4Preview && editorLangId =~ /^(:?plaintext|hoi4|paradox)$/ && !shouldHideHoi4Preview",
					"group": "navigation"
				},
				{
					"command": "hoi4modernutils.preview",
					"when": "shouldShowHoi4Preview && resourceScheme != webview-panel",
					"group": "navigation"
				}
			],
			"commandPalette": [
				{
					"command": "hoi4modernutils.preview",
					"when": "!shouldHideHoi4Preview && resourceScheme != webview-panel"
				},
				{
					"command": "hoi4modernutils.scanreferences",
					"when": "!hoi4MULoaded || hoi4PreviewType == event"
				},
				{
					"command": "hoi4modernutils.scanAndLogErrors"
				},
				{
					"command": "hoi4modernutils.selectmodfile"
				},
				{
					"command": "hoi4modernutils.previewworld"
				},
				{
					"command": "hoi4modernutils.selecthoifolder"
				},
				{
					"command": "hoi4modernutils.test",
					"when": "hoi4MUInDev"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "webpack --mode production",
		"webpack": "webpack --mode development",
		"webpack-dev": "webpack --mode development --watch --progress",
		"web-ext": "serve --cors -l 5000 --ssl-cert \"%CERT_PATH%/localhost.cer\" --ssl-key \"%CERT_PATH%/localhost.key\"",
		"compile-ts": "tsc -d -p ./ --module commonjs",
		"lint": "eslint src --ext ts",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile-ts && npm run lint",
		"test": "mocha ./out/test/**/*.test.js",
		"profile-worldmap-render": "webpack --config scripts/profile-worldmap-render.webpack.js && node scripts/.profile-build/profile-worldmap-render.cjs --output profiles/worldmap-render-profile.json",
		"profile-worldmap-webview": "node scripts/profile-worldmap-webview.js",
		"profile-worldmap-webview-aggressive": "node scripts/profile-worldmap-webview.js --focused --optimizations warning-index,edge-decimation,river-device-pixel-collapse,label-grid-dedupe,coarse-provinces --allow-pixel-changes --output profiles/worldmap-webview-runtime-aggressive.json",
		"pretest-ui": "npm run compile-ts && npm run lint && npm run vscode:prepublish",
		"test-ui": "node ./out/test-ui/runTest.js",
		"clean": "rimraf dist out static",
		"geni18n": "npm run compile-ts && node scripts/genzhi18n.js"
	},
	"devDependencies": {
		"@types/copy-webpack-plugin": "^8.0.0",
		"@types/glob": "^7.1.1",
		"@types/js-yaml": "^3.12.5",
		"@types/lodash": "^4.14.149",
		"@types/mocha": "^7.0.2",
		"@types/node": "^22.9.0",
		"@types/pngjs": "^3.4.2",
		"@types/vscode": "^1.52.0",
		"@typescript-eslint/eslint-plugin": "^4.9.0",
		"@typescript-eslint/parser": "^4.9.0",
		"copy-webpack-plugin": "^14.0.0",
		"eslint": "^7.32.0",
		"glob": "^7.1.6",
		"mocha": "^8.1.3",
		"raw-loader": "^4.0.1",
		"rimraf": "^3.0.2",
		"serve": "^14.2.0",
		"terser-webpack-plugin": "^5.3.11",
		"ts-loader": "^9.4.1",
		"tslib": "^2.2.0",
		"typescript": "^4.9.0",
		"vscode-test": "^1.3.0",
		"webpack": "^5.108.4",
		"webpack-cli": "^4.7.0"
	},
	"dependencies": {
		"@vscode/codicons": "^0.0.33",
		"@vscode/extension-telemetry": "^0.4.6",
		"adm-zip": "^0.6.0",
		"assert": "^2.0.0",
		"browserify-zlib": "^0.2.0",
		"buffer": "^6.0.3",
		"js-yaml": "^3.14.0",
		"lodash": "^4.17.21",
		"path-browserify": "^1.0.1",
		"pngjs": "^5.0.0",
		"process": "^0.11.10",
		"repomix": "^1.13.1",
		"rxjs": "^6.6.3",
		"stream-browserify": "^3.0.0",
		"tga": "^1.0.4",
		"url": "^0.11.0",
		"util": "^0.12.5"
	}
}
