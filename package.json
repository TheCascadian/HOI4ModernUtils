				"category": "%hoi4modernutils.category%"
			},
			{
				"command": "hoi4modernutils.selecthoifolder",
				"title": "%hoi4modernutils.selecthoifolder.title%",
				"category": "%hoi4modernutils.category%"
			},
			{
				"command": "hoi4modernutils.test",
